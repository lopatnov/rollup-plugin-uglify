{
  "name": "@lopatnov/rollup-plugin-uglify",
  "version": "4.3.0",
  "description": "A Rollup plugin for minifying JavaScript bundles using Terser",
  "author": {
    "name": "Oleksandr Lopatnov",
    "url": "https://github.com/lopatnov"
  },
  "license": "Apache-2.0",
  "homepage": "https://lopatnov.github.io/rollup-plugin-uglify/",
  "umdName": "uglify",
  "source": "src/plugin.ts",
  "main": "dist/plugin.cjs.js",
  "module": "dist/plugin.es.mjs",
  "browser": "dist/plugin.umd.js",
  "types": "dist/plugin.d.ts",
  "exports": {
    ".": {
      "types": "./dist/plugin.d.ts",
      "browser": "./dist/plugin.umd.js",
      "import": "./dist/plugin.es.mjs",
      "require": "./dist/plugin.cjs.js"
    }
  },
  "keywords": [
    "rollup",
    "rollup-plugin",
    "uglify",
    "minify",
    "minifier",
    "terser",
    "javascript",
    "compression",
    "optimization",
    "bundle",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lopatnov/rollup-plugin-uglify.git"
  },
  "bugs": {
    "url": "https://github.com/lopatnov/rollup-plugin-uglify/issues"
  },
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -cw",
    "test": "vitest run --coverage",
    "prepare": "npm i --no-save --no-package-lock terser@latest",
    "update": "npx npm-check-updates -u && npm install"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@rollup/pluginutils": "^5.4.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@vitest/coverage-v8": "^3.2.7",
    "core-js": "^3.49.0",
    "rollup": "^4.62.2",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7"
  },
  "peerDependencies": {
    "rollup": ">=4.0.0",
    "terser": ">=4.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}